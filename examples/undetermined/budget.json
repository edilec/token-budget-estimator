{
  "schemaVersion": "1",
  "model": "vendor-mini",
  "profiles": {
    "vendor-mini": {
      "tokenizer": "o200k_base",
      "contextTokens": 1500,
      "reserveOutputTokens": 1100,
      "estimateCharsPerToken": 3.8,
      "estimateTolerance": 0.3,
      "overhead": {
        "perMessage": 4,
        "perMessageName": 1,
        "perToolDefinition": 8,
        "toolsPreamble": 16,
        "replyPrimer": 3
      }
    },
    "house-bytes": {
      "tokenizer": "utf8-bytes",
      "contextTokens": 8192,
      "reserveOutputTokens": 1024,
      "minOutputTokens": 512,
      "overhead": {
        "perMessage": 4,
        "perMessageName": 1,
        "perToolDefinition": 8,
        "toolsPreamble": 16,
        "replyPrimer": 3
      }
    }
  }
}
